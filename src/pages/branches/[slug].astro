---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CredStrip from '../../components/CredStrip.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { branches } from '../../lib/data';
import { localBusiness } from '../../lib/schema';
import { site, telHref } from '../../config/site';
import { u } from '../../lib/url';
export function getStaticPaths() { return branches.filter((b) => b.branchPage).map((b) => ({ params: { slug: b.id } })); }
const b = branches.find((x) => x.id === Astro.params.slug)!;
const path = b.branchPage!;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Branch network', path: '/branch-locator.html' }, { name: b.city, path }];
const nearby = branches.filter((x) => x.state === b.state && x.id !== b.id);
---
<Base title={b.branchTitle!} description={b.branchDescription!} path={path} crumbs={crumbs} navActive="Network" schema={[localBusiness(b, path)]}>
  <PageHero kicker={b.branchKicker} title={b.branchH1!} lede={b.branchLede} crumbs={crumbs} ctas={[{ text: `Call ${b.phones[0]}`, href: telHref(b.phones[0]) }, { text: 'Request a quote', href: '/contact_us.html#quote' }]} />
  <section class="section tone-white">
    <div class="container office">
      <div class="reveal">
        <p class="kicker">Your local dispatch contact</p>
        <h2 class="section-title">{b.branchHeading}</h2>
        <p class="lead mt-1">{b.branchIntro}</p>
        <div class="grid-2 mt-3">
          <div>
            <h3 class="sub" style="font-size:1.15rem;margin-bottom:1rem">Services to discuss with the branch</h3>
            <ul class="check-list">{(b.branchServices || []).map((x) => <li>{x}</li>)}</ul>
          </div>
          <div>
            <h3 class="sub" style="font-size:1.15rem;margin-bottom:1rem">Published capabilities</h3>
            <ul class="check-list">{b.capabilities.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
        <h3 class="sub" style="font-size:1.15rem;margin:2.4rem 0 1rem">Industrial areas and nearby locations</h3>
        <ul class="tag-list">{b.serviceAreas.map((x) => <li>{x}</li>)}</ul>
        <p class="muted mt-1" style="font-size:.9rem">Service-area tags are coverage references, not separate physical offices. Confirm the exact PIN code, cargo and date with the branch.</p>
        <div class="callout mt-3">
          <strong style="color:var(--ink)">Local route guide:</strong> sectors, connected corridors and the six details to share before booking from {b.city}.
          <div class="mt-1"><a class="text-link" href={u(b.areaPage)}>Transport in {b.city}: area and route details<Icon name="arrow" /></a></div>
        </div>
      </div>
      <aside class="office-card" aria-label={`${b.name} contact details`}>
        <div><span class="label">{b.state} contact</span><h2 style="font-size:1.6rem">{b.name}</h2></div>
        <div><span class="label">Address</span><address>{b.address}</address></div>
        <div><span class="label">Call branch</span>{b.phones.map((p) => <div><a class="big" href={telHref(p)}>{p}</a></div>)}</div>
        <div><span class="label">Customer care</span><a href={site.phoneHref} style="color:#fff">{site.phone}</a> · {site.hoursShort}</div>
        <hr />
        <div class="btn-row">
          <a class="btn btn-red" href={u('/contact_us.html#quote')}>Request a quote<Icon name="arrow" /></a>
          <a class="btn btn-ghost-light" href={b.mapUrl} target="_blank" rel="noopener">View approximate location</a>
        </div>
      </aside>
    </div>
  </section>
  <CredStrip />
  <section class="section-sm tone-warm">
    <div class="container">
      <p class="kicker">Other {b.state} branches</p>
      <ul class="tag-list">{nearby.map((x) => <li><a href={u(x.areaPage)} style="text-decoration:none">{x.city}</a></li>)}</ul>
    </div>
  </section>
  <CtaBand kicker={`Move from ${b.city}`} title="Tell us what needs to move." text="Share the shipment profile and our team will review the appropriate route and service." />
</Base>
