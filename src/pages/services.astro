---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CredStrip from '../components/CredStrip.astro';
import GenericSections from '../components/GenericSections.astro';
import OptionsGrid from '../components/OptionsGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import PatternArt from '../components/PatternArt.astro';
import { page, services } from '../lib/data';
import { u } from '../lib/url';
import truck from '../assets/images/vidhi-truck-highway.jpg';
import dock from '../assets/images/loading-dock.jpg';
import yard from '../assets/images/fleet-yard.jpg';
const d = page('services');
const catalog = d.sections.find((s: any) => s.kicker === 'Choose the right movement');
const options = d.sections.find((s: any) => s.kicker === 'Flexible commercial support');
const planning = d.sections.filter((s: any) => s.kicker === 'Better planning from the start');
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Services', path: '/services.html' }];
const imgs: Record<string, any> = { 'full-truck-load': [truck, 'Vidhi Transport Co. branded container truck on a highway'], 'part-truck-load': [dock, 'Mixed industrial cargo secured on a truck at a loading dock (illustrative)'], warehousing: [yard, 'Trucks parked at a freight yard (illustrative)'] };
const schema = [{ '@type': 'ItemList', name: 'Vidhi Transport services', itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: 'https://www.vidhitransport.com' + s.path, name: s.h1 })) }];
---
<Base title={d.title} description={d.description} path="/services.html" crumbs={crumbs} navActive="Services" schema={schema} pageType="CollectionPage">
  <PageHero kicker={d.hero.kicker} title={d.hero.title} lede={d.hero.intro} crumbs={crumbs} ctas={d.hero.ctas} image={truck} imageAlt="Vidhi Transport Co. container truck on an industrial highway" />
  <CredStrip />
  <section class="section tone-white" id="services-list">
    <div class="container">
      <div class="section-head reveal">
        <div><p class="kicker">{catalog.kicker}</p><h2 class="section-title">{catalog.title}</h2></div>
        <p class="lead">{catalog.intro?.[0]}</p>
      </div>
      <div class="card-grid">
        {services.map((s, i) => (
          <article class="card reveal" id={s.slug} style={`--d:${(i % 3) * 0.06}s;padding:0;overflow:hidden`}>
            <div style="position:relative;aspect-ratio:16/9;background:var(--ink);overflow:hidden">
              {imgs[s.slug] ? <Image src={imgs[s.slug][0]} alt={imgs[s.slug][1]} widths={[400, 640, 800]} sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 33vw" loading="lazy" style="width:100%;height:100%;object-fit:cover" /> : <PatternArt label={s.mark} variant={i} />}
            </div>
            <div style="padding:1.6rem 1.8rem 1.8rem;display:grid;gap:.8rem;flex:1">
              <span class="num">{String(i + 1).padStart(2, '0')} · {s.card.tag}</span>
              <h3><a class="card-link" href={u(s.path)}>{s.card.name}</a></h3>
              <p>{s.card.summary}</p>
              <ul class="check-list">{s.card.highlights.map((h: string) => <li>{h}</li>)}</ul>
              <div class="card-foot"><span class="text-link">{s.card.linkText}<Icon name="arrow" /></span></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section tone-warm" id="value-added-options">
    <div class="container">
      <div class="section-head reveal">
        <div><p class="kicker">{options.kicker}</p><h2 class="section-title">{options.title}</h2></div>
        <p class="lead">{options.intro?.[0]}</p>
      </div>
      <OptionsGrid groups={options.cards.map((c: any) => ({ title: c.title, items: c.list }))} />
      <p class="callout mt-2">Options can be combined, for example To Pay with Door-to-Door delivery or Account Billing with DACC, subject to customer agreement, cargo, route, documentation and operational confirmation.</p>
    </div>
  </section>
  <GenericSections sections={planning} />
  <CtaBand kicker="Discuss your requirement" title="Not sure which service fits?" text="Share the route, cargo description, approximate weight, packaging and preferred dispatch date. Our operations team will suggest the most practical next step." />
</Base>
