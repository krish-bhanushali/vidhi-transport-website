---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import GenericSections from '../components/GenericSections.astro';
import FaqList from '../components/FaqList.astro';
import TrackForm from '../components/TrackForm.astro';
import { page } from '../lib/data';
import { site } from '../config/site';
const d = page('lr-track');
const help = d.sections.filter((s: any) => s.kicker === 'Tracking support');
const faq = d.sections.find((s: any) => s.faqs);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Customer tools', path: '/tools.html' }, { name: 'Track LR', path: '/lr-track.html' }];
---
<Base title={d.title} description={d.description} path="/lr-track.html" crumbs={crumbs} navActive="Tools">
  <Fragment slot="head"><link rel="preconnect" href="https://vidhierp.in" crossorigin /></Fragment>
  <PageHero kicker={d.hero.kicker} title={d.hero.title} lede={d.hero.intro} crumbs={crumbs} tone="dark">
    <div class="mt-3" style="max-width:860px"><TrackForm id="lr" /></div>
    <p class="mt-1" style="font-size:.88rem">Need help? Call customer care on <a href={site.phoneHref} style="color:#fff">{site.phone}</a> ({site.hoursShort}).</p>
  </PageHero>
  <GenericSections sections={help} />
  <FaqList items={faq.faqs} kicker={faq.kicker} title={faq.title} tone="warm" />
</Base>
