---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { articles, fmtDate } from '../../lib/data';
import { articleNode } from '../../lib/schema';
import { u } from '../../lib/url';
export function getStaticPaths() { return articles.map((a) => ({ params: { slug: a.slug } })); }
const a = articles.find((x) => x.slug === Astro.params.slug)!;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Insights', path: '/content.html' }, { name: a.category, path: a.path }];
const toc = a.blocks.filter((b: any) => b.type === 'h2');
const related = articles.filter((x) => x.slug !== a.slug);
const relatedLinks: Record<string, { label: string; href: string }[]> = {
  'ftl-vs-ptl-industrial-freight': [{ label: 'Full Truckload Transport', href: '/services/full-truck-load.html' }, { label: 'Part Load Transport', href: '/services/part-truck-load.html' }],
  'drum-carboy-transport-checklist': [{ label: 'Chemical & Industrial Freight', href: '/services/chemical-industrial-freight.html' }, { label: 'Part Load Transport', href: '/services/part-truck-load.html' }],
  'gujarat-maharashtra-dispatch-checklist': [{ label: 'Branch locator', href: '/branch-locator.html' }, { label: 'GST & e-way bill guidance', href: '/tax-forms.html' }],
};
---
<Base title={a.title} description={a.description} path={a.path} crumbs={crumbs} navActive="Insights" ogType="article" schema={[articleNode(a)]}>
  <Fragment slot="head">
    <meta property="article:published_time" content={a.datePublished} />
    <meta property="article:section" content={a.category} />
  </Fragment>
  <PageHero kicker={a.category} title={a.h1} lede={a.lede} crumbs={crumbs} tone="dark">
    <p class="article-meta"><span>By {a.author}</span><time datetime={a.datePublished}>{fmtDate(a.datePublished)}</time><span>{a.readTime}</span></p>
  </PageHero>
  <section class="section tone-white">
    <div class="container article-layout">
      <aside class="article-aside">
        <nav aria-labelledby="toc-title" data-toc>
          <h2 id="toc-title">In this guide</h2>
          <ol>{toc.map((t: any) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
        </nav>
        <a class="btn btn-red btn-sm" href={u('/contact_us.html#quote')}>Ask about a shipment</a>
        {a.disclaimer && <p class="muted" style="font-size:.85rem">{a.disclaimer}</p>}
      </aside>
      <article class="prose">
        {a.lead && <p class="article-lead">{a.lead}</p>}
        {a.blocks.map((b: any) => b.type === 'h2' ? <h2 id={b.id}>{b.text}</h2> : b.type === 'h3' ? <h3>{b.text}</h3> : b.type === 'list' ? (b.ordered ? <ol class="check-list">{b.items.map((i: string) => <li>{i}</li>)}</ol> : <ul class="check-list">{b.items.map((i: string) => <li>{i}</li>)}</ul>) : <p>{b.text}</p>)}
        {a.note && <div class="note"><strong>Important</strong><p>{a.note}</p></div>}
        <p class="mt-2"><strong>Related services:</strong> {(relatedLinks[a.slug] || []).map((l, i) => <>{i > 0 && ' · '}<a href={u(l.href)}>{l.label}</a></>)}</p>
        <ul class="tag-list mt-1" aria-label="Topics">{a.tags.map((t: string) => <li>{t}</li>)}</ul>
      </article>
    </div>
  </section>
  <FaqList items={a.faqs} title="Questions about this guide" tone="warm" />
  <section class="section tone-white">
    <div class="container">
      <div class="section-head"><div><p class="kicker">Continue reading</p><h2 class="section-title">Related dispatch guides</h2></div><div class="section-head-actions"><a class="btn btn-outline" href={u('/content.html')}>All insights<Icon name="arrow" /></a></div></div>
      <div class="card-grid cols-2">
        {related.map((r) => (
          <a class="article-card" href={u(r.path)}><span class="meta"><span>{r.category}</span><span>{r.readTime}</span></span><h3>{r.h1}</h3><p>{r.lede}</p></a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand kicker="Ready to plan?" title="Turn the checklist into a freight enquiry." text="Share the route, cargo and timing. The operations team will review the practical movement option." />
</Base>
