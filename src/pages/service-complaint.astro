---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import FaqList from '../components/FaqList.astro';
import { complaintForm } from '../config/forms';
import { page } from '../lib/data';
import { site } from '../config/site';
const d = page('service-complaint');
const next = d.sections.find((s: any) => s.kicker === 'What happens next');
const faq = d.sections.find((s: any) => s.faqs);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Customer tools', path: '/tools.html' }, { name: 'Service complaint', path: '/service-complaint.html' }];
const steps = next.list.map((t: string) => { const m = t.match(/^(Reference check|Issue review|Response)\s+(.*)$/); return m ? { t: m[1], p: m[2] } : { t, p: '' }; });
---
<Base title={d.title} description={d.description} path="/service-complaint.html" crumbs={crumbs} navActive="Tools">
  <PageHero kicker={d.hero.kicker} title={d.hero.title} lede={d.hero.intro} points={d.hero.list} crumbs={crumbs} ctas={[{ text: 'Go to complaint form', href: '#complaint-form' }, { text: 'Track LR first', href: '/lr-track.html' }]} />
  <section class="section tone-warm" id="complaint-form">
    <div class="container detail-layout">
      <div>
        <p class="kicker">Service complaint</p>
        <h2 class="section-title">Provide the investigation details</h2>
        <p class="lead mt-1" style="margin-bottom:2rem">{d.hero.subtitle} Your details are prepared as a WhatsApp message or email to customer care, so the LR, issue type and response contact stay together.</p>
        <EnquiryForm id="complaint" type="Service Complaint" fieldsets={complaintForm} consent="I confirm these details are accurate and consent to Vidhi Transport using them to investigate and respond." copyLabel="Copy complaint" />
      </div>
      <aside class="side-card">
        <p class="kicker" style="margin:0">{next.kicker}</p>
        <h2>{next.title}</h2>
        <ol style="list-style:none;padding:0;display:grid;gap:.8rem">
          {steps.map((s: any, i: number) => <li><strong style="color:var(--ink)">{String(i + 1).padStart(2, '0')} · {s.t}</strong><br /><span class="muted">{s.p}</span></li>)}
        </ol>
        <p style="margin:0">{next.intro?.[0]}</p>
        <p style="margin:0"><a class="text-link" href={site.phoneHref}>Call {site.phone}</a></p>
        <p style="margin:0"><a class="text-link" href={`mailto:${site.email}?subject=Service%20complaint`}>Email customer care</a></p>
      </aside>
    </div>
  </section>
  <FaqList items={faq.faqs} kicker={faq.kicker} title={faq.title} tone="white" />
</Base>
