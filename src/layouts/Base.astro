---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { abs, u, isStaging } from '../lib/url';
import { organization, website, webPage, breadcrumbs as bc } from '../lib/schema';
import manrope from '../assets/fonts/manrope-latin.woff2?url';
import inter from '../assets/fonts/inter-latin.woff2?url';

interface Props {
  title: string;
  description: string;
  path: string; // canonical path, e.g. /about-us.html or /
  ogImage?: string;
  ogType?: string;
  schema?: object[];
  crumbs?: { name: string; path: string }[];
  pageType?: string;
  noindex?: boolean;
  navActive?: string;
}
const { title, description, path, ogImage = '/assets/images/og-default.jpg', ogType = 'website', schema = [], crumbs, pageType, noindex = false, navActive } = Astro.props;
const canonical = abs(path);
const robots = noindex || isStaging ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const graph = [
  organization(),
  ...(path === '/' ? [website()] : []),
  webPage(path, title, description, pageType),
  ...(crumbs && crumbs.length > 1 ? [bc(crumbs)] : []),
  ...schema,
];
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en-IN" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#15191E" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <link rel="preload" href={manrope} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vidhi Transport Co. container truck on an industrial highway" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(ogImage)} />
    <script is:inline>document.documentElement.classList.replace('no-js','js');</script>
    <script type="application/ld+json" set:html={ld} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header active={navActive} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <button class="back-to-top" type="button" aria-label="Back to top" data-back-to-top><Icon name="arrow-up" /></button>
    <script>import '../scripts/main.ts';</script>
  </body>
</html>
