---
interface Props { items: { q: string; a: string }[]; kicker?: string | null; title?: string | null; intro?: string | null; tone?: string; id?: string }
const { items, kicker = 'Helpful answers', title = 'Frequently asked questions', intro, tone = 'white', id } = Astro.props;
---
{items?.length > 0 && (
<section class={`section tone-${tone}`} id={id} aria-labelledby={(id || 'faq') + '-title'}>
  <div class="container faq">
    <div class="reveal">
      {kicker && <p class="kicker">{kicker}</p>}
      <h2 class="section-title" id={(id || 'faq') + '-title'}>{title}</h2>
      {intro && <p class="lead mt-1">{intro}</p>}
      <slot />
    </div>
    <div class="faq-list reveal" style="--d:.1s">
      {items.map((f, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>{f.q}<span class="pm" aria-hidden="true"></span></summary>
          <div class="faq-answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
)}
