---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import { u } from '../lib/url';
interface Props {
  kicker?: string | null; title: string; lede?: string[] | string | null; points?: string[];
  crumbs: { name: string; path: string }[]; ctas?: { text: string; href: string }[];
  image?: ImageMetadata; imageAlt?: string; mark?: string; tone?: 'warm' | 'dark';
}
const { kicker, title, lede, points, crumbs, ctas = [], image, imageAlt = '', mark, tone = 'warm' } = Astro.props;
const ledes = Array.isArray(lede) ? lede : lede ? [lede] : [];
const cls = ['page-hero', image ? 'has-image' : tone === 'dark' ? 'dark' : ''].join(' ');
const dark = !!image || tone === 'dark';
---
<section class={cls + (dark ? ' on-dark' : '')}>
  {image && (
    <div class="page-hero-media"><Image src={image} alt={imageAlt} widths={[640, 1024, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" /></div>
  )}
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <div class="page-hero-grid">
      <div>
        {kicker && <p class="kicker">{kicker}</p>}
        <h1 class="page-title">{title}</h1>
        {ledes.map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}
        {ctas.length > 0 && (
          <div class="btn-row">
            {ctas.map((c, i) => <a class={`btn ${i === 0 ? 'btn-red' : dark ? 'btn-ghost-light' : 'btn-outline'}`} href={u(c.href)}>{c.text}{i === 0 && <Icon name="arrow" />}</a>)}
          </div>
        )}
      </div>
      {points && points.length > 0 ? (
        <div class="page-hero-aside"><ul>{points.map((p) => <li>{p}</li>)}</ul></div>
      ) : mark ? <div class="hero-mark" aria-hidden="true">{mark}</div> : <div></div>}
    </div>
    <slot />
  </div>
</section>
