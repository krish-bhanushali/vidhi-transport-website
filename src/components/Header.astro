---
import { Image } from 'astro:assets';
import logo from '../assets/images/vidhi-logo.png';
import Icon from './Icon.astro';
import { mainNav } from '../config/nav';
import { site } from '../config/site';
import { u } from '../lib/url';
const { active } = Astro.props as { active?: string };
---
<div class="utility">
  <div class="container">
    <div class="utility-group">
      <span><Icon name="phone" /><a href={site.phoneHref}>{site.phone}</a></span>
      <span class="hide-sm"><Icon name="mail" /><a href={`mailto:${site.email}`}>{site.email}</a></span>
    </div>
    <div class="utility-group">
      <span class="hide-sm"><Icon name="clock" />Customer care {site.hoursShort}</span>
      <a href={u('/help-desk.html')}>Help desk</a>
    </div>
  </div>
</div>
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href={u('/')} aria-label="Vidhi Transport Co. home">
      <Image src={logo} alt="Vidhi Transport Co." width={198} height={34} widths={[198, 396]} sizes="198px" loading="eager" fetchpriority="high" />
    </a>
    <nav class="primary-nav" aria-label="Primary">
      <ul class="nav-list">
        {mainNav.map((item, i) => (
          <li class="nav-item" data-nav-item>
            <a class="nav-trigger" href={u(item.href)} aria-expanded="false" aria-controls={`mega-${i}`} aria-current={active === item.label ? 'true' : undefined} data-nav-trigger>
              {item.label}<Icon name="chev" class="chev" />
            </a>
            <div class="mega" id={`mega-${i}`} data-mega>
              <div class="container mega-inner">
                <div class="mega-intro">
                  <h2>{item.label}</h2>
                  <p>{item.intro}</p>
                  <a class="text-link" href={u(item.href)}>{item.label === 'Network' ? 'Open branch locator' : item.label === 'Tools' ? 'All customer tools' : `Explore ${item.label.toLowerCase()}`}<Icon name="arrow" /></a>
                </div>
                <div class="mega-groups">
                  {item.groups.map((g) => (
                    <div>
                      <h3>{g.title}</h3>
                      <ul>{g.links.map((l) => <li><a href={u(l.href)}>{l.label}</a></li>)}</ul>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="btn btn-outline btn-sm hide-md" href={u('/lr-track.html')}>Track LR</a>
      <a class="btn btn-red btn-sm" href={u('/contact_us.html#quote')}>Get a quote</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-panel" data-menu-toggle><span></span><span class="sr-only">Menu</span></button>
    </div>
  </div>
  <div class="mobile-panel" id="mobile-panel" data-mobile-panel>
    {mainNav.map((item) => (
      <details>
        <summary>{item.label}</summary>
        <ul>
          <li><a href={u(item.href)}><strong>{item.label} overview</strong></a></li>
          {item.groups.flatMap((g) => g.links).filter((l) => l.href !== item.href).map((l) => <li><a href={u(l.href)}>{l.label}</a></li>)}
        </ul>
      </details>
    ))}
    <div class="mobile-cta">
      <a class="btn btn-red" href={u('/contact_us.html#quote')}>Get a freight quote</a>
      <a class="btn btn-outline" href={u('/lr-track.html')}>Track LR</a>
    </div>
    <div class="mobile-contact">
      <p><a href={site.phoneHref}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a><br />{site.hours}</p>
    </div>
  </div>
</header>
